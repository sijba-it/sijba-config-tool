{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sijba Handler Config",
  "type": "object",
  "required": ["id", "direction", "type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "priority": {"type": "number"},
    "direction": {"type": "string", "enum": ["inbound", "outbound"]},
    "category": {"type": "array", "items": {"type": "string"}},
    "type": {"type": "string", "enum": ["exec_json", "http"]},
    "required": {"type": "boolean"},
    "await_response": {"type": "boolean"},
    "allow_direct_inject": {"type": "boolean"},
    "continue_on_match": {"type": "boolean"},
    "match": {
      "type": "object",
      "properties": {
        "regex": {"type": "string"},
        "source": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "exec": {"type": "string"},
    "args": {"type": "array", "items": {"type": "string"}},
    "timeout_seconds": {"type": "number"},
    "context": {
      "type": "object",
      "properties": {
        "namespace": {"type": "string"},
        "key": {"type": "string"}
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "router_hint": {"type": "string"},
    "receive_handler_context": {"type": "boolean"},
    "startup": {
      "type": "object",
      "properties": {
        "url": {"type": "string"},
        "invoke_path": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
